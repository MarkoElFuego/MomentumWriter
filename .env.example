# Kopiraj u .env.local i popuni. .env.local se NE commituje.
OPENAI_API_KEY=
# Brz i jeftin model je dovoljan za kratke impulse
AI_MODEL=gpt-6-luna
# Koliko reči pre kursora šaljemo AI-ju
AI_CONTEXT_WORDS=400
# Sivi tekst (dopune dok kucaš) — manji kontekst, jeftinije i brže
AI_GHOST_CONTEXT_WORDS=150
# Koliko sivi tekst „razmišlja” pre odgovora: none | low | medium (manje = brže; gpt-6-luna ne podržava minimal)
AI_GHOST_REASONING_EFFORT=none
# „Zapeo sam” (Tiron): koliko razmišlja pre pitanja — low je brzo (~2 s); kod Tirona nikad none
AI_EFFORT_STUCK=low
# Tiron pamti (memorija, sažetak poglavlja, najjača rečenica) — radi u pozadini, mora tačno da pročita poglavlje
AI_EFFORT_MEMORY=medium
# Tironovi šapati (ulazak, kraj poglavlja, obrazac) — povezuje srce knjige, memoriju i signale; nikad none
AI_EFFORT_TIRON=medium
# Šapat na kraju sesije — kratak pogled unazad
AI_EFFORT_SESSION_END=low
